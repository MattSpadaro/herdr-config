 const ROW_PX = 30;   // a list row; the wheel moves the window a row per ROW_PX
 
+const MENU_GROUPS = [
+  { key: "builtin", label: "Built-in" },
+  { key: "personal", label: "Personal" },
+  { key: "project", label: "Project" },
+  { key: "plugins", label: "Plugins", nested: true },
+  { key: "mcps", label: "MCPs", nested: true },
+];
+
+export function slashGroups(list) {
+  const out = { builtin: [], personal: [], project: [], plugins: new Map(), mcps: new Map() };
+  const nest = (kind, owner, c, label) => {
+    if (!out[kind].has(owner)) out[kind].set(owner, []);
+    out[kind].get(owner).push({ ...c, label });
+  };
+  for (const c of list ?? []) {
+    const name = String(c?.name ?? "");
+    if (!name) continue;
+    if (name.startsWith("mcp__")) {
+      const [server, ...rest] = name.slice(5).split("__");
+      nest("mcps", server || "mcp", c, rest.join("__") || name);
+    } else if (c.source === "plugin") {
+      const [owner, ...rest] = name.split(":");
+      nest(/mcp/i.test(owner) ? "mcps" : "plugins", owner, c, rest.join(":") || name);
+    } else if (c.source === "builtin") out.builtin.push({ ...c, label: name });
+    else if (c.source === "project") out.project.push({ ...c, label: name });
+    else out.personal.push({ ...c, label: name });
+  }
+  return out;
+}
+
+export function menuEntries(groups, path) {
+  const [group, owner] = path;
+  if (!group) {
+    return MENU_GROUPS.map((g) => {
+      const v = groups[g.key];
+      const count = g.nested ? v.size : v.length;
+      return count ? { kind: "group", key: g.key, label: g.label, count } : null;
+    }).filter(Boolean);
+  }
+  const v = groups[group];
+  if (!v) return [];
+  if (v instanceof Map && !owner) {
+    return [...v.entries()].sort(([a], [b]) => a.localeCompare(b))
+      .map(([key, items]) => ({ kind: "group", key, label: key, count: items.length }));
+  }
+  const items = v instanceof Map ? v.get(owner) ?? [] : v;
+  return [...items].sort((a, b) => a.label.localeCompare(b.label)).map((c) => ({ kind: "cmd", cmd: c }));
+}
+
+export function menuTitle(path) {
+  const [group, owner] = path;
+  const g = MENU_GROUPS.find((x) => x.key === group);
+  return [g?.label ?? group, owner].filter(Boolean).join(" / ");
+}
