diff -ruN -x gpui-kit.d.ts -x jsconfig.json a/herdr-app/mods/flockbook/estimate.js b/herdr-app/mods/flockbook/estimate.js
--- a/herdr-app/mods/flockbook/estimate.js
+++ b/herdr-app/mods/flockbook/estimate.js
@@ -7,7 +7,7 @@
 // No percentage on top: on a long pasted message 8% of the height was many lines of empty space.
 import { splitBlocks, tableCells } from "./blocks.js";
 import { ROW_PAD_Y, BUBBLE_PAD_Y, bubbleTextWidth, BUBBLE_GAP, IMAGES_LINE_H, CHIP_ROW, CHIP_GAP, OPEN_INDENT, CALL_H, CALLS_PAD,
-  SEP_H, FOOTER_H, STATUS_H, CARD_ROW_H, OTHER_H } from "./metrics.js";
+  SEP_H, FOOTER_H, STATUS_H, CARD_ROW_H, OTHER_H, QA_LABEL_H, QA_GAP, QA_PAIR_GAP } from "./metrics.js";
 
 export const READ_W = 760;  // the reading column's width at most
 export const GUTTER = 24;   // each side of the column
@@ -262,11 +262,31 @@
     case "sep": return SEP_H;
     case "footer": return FOOTER_H;
     case "status": return STATUS_H;
-    case "perm": case "question": return CARD_ROW_H;
+    case "question": { const qa = qaPairs(row); return qa ? qaHeight(qa, width, k, zoom) : CARD_ROW_H; }
+    case "perm": return CARD_ROW_H;
     default: return OTHER_H;
   }
 }
 
+export function qaPairs(row) {
+  const q = row?.question;
+  if (q?.state !== "answered" || !Array.isArray(q.answers)) return null;
+  const qs = q.questions ?? [];
+  if (!qs.length || q.answers.length !== qs.length) return null;
+  return qs.map((x, i) => ({
+    label: x.header ? `The agent asked · ${x.header}` : "The agent asked",
+    text: x.text || "",
+    answer: String(q.answers[i] ?? "").trim() || "Skipped",
+    skipped: !String(q.answers[i] ?? "").trim(),
+  }));
+}
+
+function qaHeight(pairs, width, k, zoom) {
+  const one = (p) => QA_LABEL_H + QA_GAP + markdownHeight(p.text, width, null, k, zoom) + QA_GAP
+    + markdownHeight(p.answer, bubbleTextWidth(width), null, k, zoom) + 2 * BUBBLE_PAD_Y;
+  return 2 * ROW_PAD_Y + pairs.reduce((h, p) => h + one(p), 0) + (pairs.length - 1) * QA_PAIR_GAP;
+}
+
 export function sizes(rows, width, open = new Set(), k = 1, zoom = 1) {
   return rows.map((r) => rowHeight(r, width, open.has(r.id), k, zoom));
 }
