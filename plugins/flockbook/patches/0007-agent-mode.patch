+const MODE_MS = 2000;
+export const MODES = [
+  { key: "default", label: "Default" },
+  { key: "acceptEdits", label: "Accept edits" },
+  { key: "plan", label: "Plan mode" },
+  { key: "auto", label: "Auto mode" },
+  { key: "bypass", label: "Bypass permissions" },
+];
+
+export function modeFromScreen(text) {
+  const tail = String(text ?? "").split("\n").map((l) => l.trim()).filter(Boolean).slice(-6).join("\n");
+  if (/plan mode on/i.test(tail)) return "plan";
+  if (/accept edits on/i.test(tail)) return "acceptEdits";
+  if (/auto mode on/i.test(tail)) return "auto";
+  if (/bypass permissions on/i.test(tail)) return "bypass";
+  if (/\? for shortcuts|esc to interrupt/i.test(tail)) return "default";
+  return null;
+}
+
+export function modeColor(key, t) {
+  return { plan: t.ansi4, acceptEdits: t.ansi5, auto: t.ansi3, bypass: t.ansi1 }[key] ?? null;
+}
+
+export const MODE_ACTION = "flockbook_mode_next";
+let modeBound = false;
+function bindMode(cx) {
+  if (modeBound || typeof cx?.bind_keys !== "function") return;
+  try {
+    cx.bind_keys([{ keystroke: "shift-tab", action: MODE_ACTION, context: `${PASTE_CONTEXT} > Input` }]);
+    modeBound = true;
+  } catch { }
+}
+
+let hcBin = null;
+async function hc(args) {
+  for (const bin of hcBin ? [hcBin] : ["hc", `${home()}/.local/bin/hc`]) {
+    try {
+      const r = await exec(bin, args);
+      if (r && r.code !== 127) { hcBin = bin; return r; }
+    } catch { }
+  }
+  return null;
+}
