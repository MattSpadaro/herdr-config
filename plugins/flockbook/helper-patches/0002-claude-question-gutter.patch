+    );
+    let screen = "────────────────────────────────────────\n ☐ Teste\n\n│ Teste final do campo livre: no modo chat, escreva uma resposta com acentos e pelo menos uma quebra de linha feita\n│ com Shift+Enter, depois aperte Enter para enviar. Qual é a sua comida preferida?\n\n❯ 1. Feijoada\n     Opção de controle; use o campo livre para o teste.\n  2. Lasanha\n     Opção de controle; use o campo livre para o teste.\n  3. Type something.\n────────────────────────────────────────\n  4. Chat about this\n\nEnter to select · ↑/↓ to navigate · Esc to cancel\n";
+    assert!(ex(&q, 0, screen, None, FieldFocus::Auto, None), "2.1.323: the │ gutter before the question text is not text");
+    let other_open = screen.replace("❯ 1. Feijoada", "  1. Feijoada").replace("  3. Type something.", "❯ 3. Type something.");
+    assert!(ex(&q, 0, &other_open, Some(""), FieldFocus::Auto, None), "2.1.323: the empty Other row with the focus");
+}
