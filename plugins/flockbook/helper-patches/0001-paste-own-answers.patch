+#[test]
+fn question_keys_non_ascii_other() {
+    let opts2 = || vec![opt("A"), opt("B")];
+    let single = request("t", "claude", vec![question("H", "Pick one?", opts2(), false)]);
+    let multi = request("t", "claude", vec![question("H", "Pick some?", opts2(), true)]);
+    assert_eq!(
+        steps(&single, &[other(&[], "ação e você")]).ok(),
+        Some(vec![text("3"), text("ação e você"), key(&["Enter"])]),
+        "claude single Other with accents: the text is followed by Enter, so it can be pasted"
+    );
+    assert!(steps(&multi, &[other(&[0], "ação")]).is_err(), "claude multiSelect Other with accents: refused before any key");
+    assert!(steps(&multi, &[other(&[0], "acao")]).is_ok(), "claude multiSelect Other in ASCII: unchanged");
+    assert_eq!(
+        steps(&single, &[other(&[], "first line\nsecond line")]).ok(),
+        Some(vec![text("3"), text("first line\nsecond line"), key(&["Enter"])]),
+        "claude single Other with a line break: pasted, then Enter"
+    );
+    assert!(steps(&multi, &[other(&[0], "a\nb")]).is_err(), "claude multiSelect Other with a line break: refused before any key");
+    assert!(steps(&single, &[other(&[], "a\rb")]).is_err(), "a carriage return is still refused");
+}
