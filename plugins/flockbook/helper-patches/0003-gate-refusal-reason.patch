@@ -70,6 +70,19 @@
 /// True when the next key may go: the pane still shows the gate's agent (same kind and identity; fresh snapshot) and
 /// `agent_ok` holds for it as it is now, then `ok` holds on a fresh screen read, then `allowed()`. The screen is read
 /// last, right before the answer. No gate: true, nothing read.
+thread_local! {
+    static LAST_REFUSAL: std::cell::RefCell<Option<(&'static str, String)>> = const { std::cell::RefCell::new(None) };
+}
+
+fn refuse(why: &'static str, screen: String) -> bool {
+    LAST_REFUSAL.with(|r| *r.borrow_mut() = Some((why, screen)));
+    false
+}
+
+pub fn take_refusal() -> Option<(&'static str, String)> {
+    LAST_REFUSAL.with(|r| r.borrow_mut().take())
+}
