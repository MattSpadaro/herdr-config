+pub fn box_options(b: &ScreenBox) -> Vec<(String, String)> {
+    static OPT: OnceLock<Regex> = OnceLock::new();
+    let Some(ask) = b.lines.iter().rposition(|l| l.contains(PROMPT_MARKER)) else { return vec![] };
+    let mut out: Vec<(String, String)> = vec![];
+    for l in &b.lines[ask + 1..] {
+        if let Some(c) = re(&OPT, r"^(\d)\.\s+(.+)$").captures(l) {
+            out.push((c[1].to_string(), trim_ws(&c[2]).to_string()));
+        } else if let Some(last) = out.last_mut() {
+            last.1.push(' ');
+            last.1.push_str(trim_ws(l));
+        }
+    }
+    out
+}
