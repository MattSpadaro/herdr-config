+#[test]
+fn box_options_lists_every_option() {
+    let b = screen_box(&notice_prompt()).expect("the prompt box is read");
+    let want = vec![
+        ("1".to_string(), "Yes".to_string()),
+        ("2".to_string(), "Yes, and always allow access to /repo from this project".to_string()),
+        ("3".to_string(), "Yes, and switch to auto mode · auto mode handles these prompts for you".to_string()),
+        ("4".to_string(), "No".to_string()),
+    ];
+    assert_eq!(box_options(&b), want, "every option row, the focus mark dropped");
+    let wrapped = notice_prompt().replace(
+        "   2. Yes, and always allow access to /repo from this project",
+        "   2. Yes, and always allow access to /repo\n      from this project",
+    );
+    let b = screen_box(&wrapped).expect("the wrapped prompt box is read");
+    assert_eq!(box_options(&b)[1].1, "Yes, and always allow access to /repo from this project", "a wrapped option joins its lines");
+}
