+#[allow(clippy::too_many_arguments)]
+pub fn respond_choice_if_open<S: PaneScreen + ?Sized>(
+    screen: &S,
+    pane_id: &str,
+    prompt: &str,
+    choice: &str,
+    label: &str,
+    agent_kind: &str,
+    blocked: bool,
+    pending: Option<&PermissionRequest>,
+    gate: Option<&KeyGate>,
+) -> Result<bool, HerdrError> {
+    if agent_kind == "grok" || choice.len() != 1 || !choice.chars().all(|c| c.is_ascii_digit()) {
+        return Ok(false);
+    }
+    let mut blocked = blocked;
+    if let Some(seen) = gate.and_then(|g| g.agent.as_ref()) {
+        let Some(now) = fresh_agent(screen, seen, pane_id) else { return Ok(false) };
+        blocked = now.status == AgentStatus::Blocked;
+    }
+    let Some(now) = approval_state(screen, pane_id, agent_kind, blocked, pending) else { return Ok(false) };
+    if outcome(true, Some(prompt), Some(&now), true) != (Outcome::Send { allow: true }) {
+        return Ok(false);
+    }
+    if let Some(allowed) = gate.and_then(|g| g.allowed.as_ref()) {
+        if !allowed() {
+            return Ok(false);
+        }
+    }
+    let text = screen.visible_text(pane_id)?;
+    let Some(b) = screen_box(&text) else { return Ok(false) };
+    if b.clipped || !box_options(&b).iter().any(|(k, l)| k == choice && l == label) {
+        return Ok(false);
+    }
+    screen.send_keys(choice.as_bytes(), pane_id)?;
+    Ok(true)
+}
