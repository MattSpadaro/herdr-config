+// Windows machines: ConPTY drops the OSC 7501 status, so their agents never reach agents().
+// A Claude Code hook there (hc-agent-state.sh) labels its terminal cc.state / cc.seq instead;
+// those terminals become cards here. "done" turns "idle" once you focus it, as Herdr does.
+const CLAUDE = { key: "claude", name: "Claude Code", icon: "icons/claude.svg", tint: false, tile: null, color: null, shell: false, agent: true };
+const lookedDone = {};
+const labelled = () => {
+  const local = agents();
