+// Yellow pane light. One click: pane.zoom. A second click within 1 s while in Split keeps the
+// pane zoomed and hides the board (Terminal view): only that terminal is left. The next click
+// undoes both. Switching views by hand in between forgets the solo state.
+const zoom = { at: 0, pane: null, solo: null };
+const zoomClick = (pane) => {
+  const now = Date.now();
+  const zoomed = (id) => panes().find((x) => x.pane === id)?.zoomed;
+  if (zoom.solo && view() !== "terminal") zoom.solo = null;
+  if (zoom.solo) {
+    const s = zoom.solo;
+    zoom.solo = null; zoom.at = 0;
+    if (zoomed(s.pane)) run("pane.zoom", { pane: s.pane });
+    setView(s.view);
+    return;
+  }
+  if (zoom.pane === pane && now - zoom.at < 1000 && view() === "split") {
+    zoom.at = 0;
+    if (!zoomed(pane)) run("pane.zoom", { pane });
+    zoom.solo = { pane, view: "split" };
+    setView("terminal");
+    return;
+  }
+  zoom.at = now; zoom.pane = pane;
+  run("pane.zoom", { pane });
+};
 // Windows machines: ConPTY drops the OSC 7501 status, so their agents never reach agents().
